<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="ComercioWeb.Site" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="utf-8" />
    <title>Mi Comercio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>
    <form id="form1" runat="server">

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">

                <a class="navbar-brand" href="Inicio.aspx">Mi Comercio</a>

                <ul class="navbar-nav me-auto">

                    <asp:PlaceHolder ID="menuConSesion" runat="server" Visible="false">

                        <li class="nav-item">
                            <a class="nav-link" href="Inicio.aspx">Inicio</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="Productos.aspx">Productos</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="Clientes.aspx">Clientes</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="Proveedores.aspx">Proveedores</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="NuevaCompra.aspx">Compras</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="NuevaVenta.aspx">Ventas</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Administrar</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="Marcas.aspx">Marcas</a></li>
                                <li><a class="dropdown-item" href="Categorias.aspx">Categorías</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <asp:LinkButton ID="btnCerrarSesion" runat="server"
                                CssClass="nav-link" OnClick="btnCerrarSesion_Click">
                                Cerrar sesión
                            </asp:LinkButton>
                        </li>

                    </asp:PlaceHolder>

                    <asp:PlaceHolder ID="menuSinSesion" runat="server">

                        <li class="nav-item">
                            <a class="nav-link" href="Login.aspx">Ingresar</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="Registro.aspx">Registrarse</a>
                        </li>

                    </asp:PlaceHolder>

                </ul>

            </div>
        </nav>

        <div class="container py-4">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
